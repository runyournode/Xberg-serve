# syntax=docker/dockerfile:1.7
#
# Profile "ultralight": document extraction, no OCR, no ML/ONNX. HEIC/AVIF
# included (libheif is a codec, not a model -- see README). Runtime stage is
# distroless: no shell, no package manager, no apt sources, nothing beyond
# glibc/libstdc++/libheif + the static tini binary + the xberg binary itself.
#
# --no-default-features + api,heic pulls in, transitively:
#   legacy-base -> formats-no-heic + analysis + core-cli + ocr-surface(empty gate)
#   xberg/api   -> axum server
#   heic        -> formats (formats-no-heic + HEIC/AVIF via libheif)
# and therefore EXCLUDES everything expensive that xberg-cli's default
# profile would drag in: ocr, paddle-ocr, sceptre-ocr, candle-vlm-ocr,
# layout-detection, embeddings, chunking-tokenizers, liter-llm, tree-sitter.

ARG RUST_IMAGE=rust:1.98-trixie
ARG ASSEMBLE_IMAGE=debian:trixie-slim
ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian13:nonroot

FROM ${RUST_IMAGE} AS builder
ARG XBERG_VERSION=1.1.1

# libheif-dev: HEIC/AVIF codec headers, discovered via pkg-config by
# xberg-libheif's build.rs. Everything else (gcc/g++) already ships in the
# rust image. If this stage ever starts needing cmake or clang, an OCR/ML
# feature crept back in -- treat that as a regression.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends pkg-config libheif-dev; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN cargo install xberg-cli \
      --version "${XBERG_VERSION}" \
      --locked \
      --no-default-features \
      --features "api,heic" \
      --root /out \
 && strip /out/bin/xberg

# Record what actually got linked. This is the guard rail: if OCR or ORT
# features sneak back in, extra shared objects show up here and the build
# breaks loudly instead of silently shipping a fatter image. Expect to see
# libheif here and nothing else unusual.
RUN ldd /out/bin/xberg | tee /out/ldd.txt

# Collect the runtime .so closure for the distroless final stage below, which
# has no apt/shell to install anything itself. Skip the handful already
# guaranteed present in gcr.io/distroless/cc-debian13 (libc, libm, libpthread,
# libdl, librt, libgcc_s, libstdc++, the dynamic linker) -- copying our own
# copies over those is unnecessary duplication.
RUN set -eux; \
    mkdir -p /out/lib; \
    ldd /out/bin/xberg | awk '{print $3}' | grep '^/' | sort -u \
      | grep -Ev '/(libc|libm|libpthread|libdl|librt|libgcc_s|libstdc\+\+|ld-linux-x86-64)\.so' \
      | while read -r so; do \
          mkdir -p "/out/lib$(dirname "$so")"; \
          cp -L "$so" "/out/lib$so"; \
        done; \
    find /out/lib -type f

# libheif dlopen()s its codec plugins at runtime instead of linking them --
# `ldd` above never sees them, so a naive "copy whatever ldd says" conversion
# would build clean and then silently fail to decode HEIC at runtime. Copy
# whichever plugin package(s) apt actually resolved (libheif1's Depends is
# libheif-plugin-libde265 plus one of dav1d/aomdec) explicitly instead.
RUN set -eux; \
    for pkg in libheif-plugin-libde265 libheif-plugin-dav1d libheif-plugin-aomdec; do \
        dpkg -s "$pkg" >/dev/null 2>&1 || continue; \
        for f in $(dpkg -L "$pkg" | grep '\.so'); do \
            mkdir -p "/out/lib$(dirname "$f")"; \
            cp -L "$f" "/out/lib$f"; \
        done; \
    done; \
    find /out/lib -name '*.so*'

# --- assemble: gathers everything the shell-less final stage needs, so the
# final stage can be pure COPY instructions. Has apt/shell; nothing here ships.
FROM ${ASSEMBLE_IMAGE} AS assemble
ARG TINI_VERSION=0.19.0
# Published at https://github.com/krallin/tini/releases/download/v0.19.0/tini-static-amd64.sha256sum
ARG TINI_SHA256=c5b0666b4cb676901f90dfcb37106783c5fe2077b04590973b885950611b30ee

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl -fsSL -o /tini "https://github.com/krallin/tini/releases/download/v${TINI_VERSION}/tini-static-amd64"; \
    echo "${TINI_SHA256}  /tini" | sha256sum -c -; \
    chmod 0755 /tini

# Content-hash cache dir. Bind-mounted from docker/mount_runtime/ in
# docker/compose.yaml -- the host directory must be chowned to 65532:65532
# (gcr.io/distroless/cc-debian13:nonroot's fixed UID) for this to be writable.
RUN mkdir -p /assemble/app/.xberg && chown 65532:65532 /assemble/app/.xberg

FROM ${RUNTIME_IMAGE} AS runtime
ARG XBERG_VERSION=1.1.1

LABEL org.opencontainers.image.title="xberg-serve-ultralight" \
      org.opencontainers.image.description="xberg REST extraction server, no OCR/ML, HEIC included, distroless" \
      org.opencontainers.image.version="${XBERG_VERSION}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/xberg-io/xberg"

WORKDIR /app

COPY --from=builder /out/bin/xberg /usr/local/bin/xberg
COPY --from=builder /out/ldd.txt   /usr/local/share/xberg/ldd.txt
COPY --from=builder /out/lib/      /
COPY --from=assemble /tini         /tini
COPY --from=assemble --chown=65532:65532 /assemble/app/.xberg /app/.xberg

ENV XBERG_CACHE_DIR=/app/.xberg \
    RUST_LOG=info

# gcr.io/distroless/cc-debian13:nonroot already runs as a fixed non-root user
# (uid/gid 65532) -- no useradd/groupadd here, there's no shell to run them.
USER 65532:65532
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/xberg", "--version"]

# Verify the exact flag names once against the built image:
#   docker run --rm xberg-serve:ultralight serve --help
ENTRYPOINT ["/tini", "--", "/usr/local/bin/xberg"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
