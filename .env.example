# Copy to .env next to docker/compose.yaml. Both profiles read these.
#   cp .env.example .env

# Image tag published by .github/workflows/docker-publish.yaml
# (ghcr.io/runyournode/xberg-serve:<tag>-ultralight / -ocrlight).
# "main" tracks the default branch; pin a released vX.Y.Z once you cut one.
XBERG_TAG=main

XBERG_PORT=8083
XBERG_OCR_PORT=8084
XBERG_LOG=info

# Hard caps. ultralight is CPU-bound and single-purpose; give it a small,
# predictable budget so a pathological document cannot starve the host.
XBERG_CPUS=2
XBERG_MEM=1g

# ocrlight needs more headroom: Tesseract renders pages to bitmaps.
XBERG_OCR_CPUS=4
XBERG_OCR_MEM=3g

# Concurrency ceiling inside xberg. Keep <= XBERG_CPUS(_OCR) to avoid thrash.
XBERG_MAX_CONCURRENT=2
